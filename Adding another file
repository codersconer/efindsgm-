  async function submit(e:any){ e.preventDefault(); setLoading(true); const data=Object.fromEntries(new FormData(e.target).entries()); const res=await fetch("/api/skills",{method:"POST",body:JSON.stringify(data)}); const j=await res.json(); if(j.ok){alert("Skill Posted!"); location.href="/";} else {alert(j.error); if(j.error.includes("Login")) location.href="/login";} setLoading(false); }
