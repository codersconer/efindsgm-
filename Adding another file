"use client";
import { useState,useEffect } from "react";
const CATS=["All","Construction","Tailoring","IT","Taxi Driving","Carpentery","Welding","Electrician","Plumbing","Satellite Installation","Job Hirings","Graphic Designers","Photographers","Video Editors","Barbers","Mechanics"];
const LOCS=["All","Sukuta","Brusubi","Serekunda","Brikama","Bijilo","Kololi","Bundung","Tallinding","Kanifing","Bakau","Fajara"];
export default function Search(){
  const [type,setType]=useState("skills"); const [cat,setCat]=useState("All"); const [loc,setLoc]=useState("All"); const [q,setQ]=useState(""); const [res,setRes]=useState<any[]>([]); const [loading,setLoading]=useState(false);
  async function doSearch(){ setLoading(true); const p=new URLSearchParams(); if(q) p.set("q",q); if(cat!="All") p.set("category",cat); if(loc!="All") p.set("location",loc); p.set("type",type); const r=await fetch(`/api/search?${p}`); setRes(await r.json()); setLoading(false); }
  useEffect(()=>{doSearch();},[type,cat,loc]);
  return (<div><div className="bg-white p-4 rounded-2xl shadow space-y-3"><div className="flex gap-2"><button onClick={()=>setType("skills")} className={`px-4 py-2 rounded-full text-sm ${type==="skills"?"bg-blue-600 text-white":"bg-gray-100"}`}>Skills</button><button onClick={()=>setType("jobs")} className={`px-4 py-2 rounded-full text-sm ${type==="jobs"?"bg-gray-900 text-white":"bg-gray-100"}`}>Jobs</button></div><div className="flex gap-2"><input value={q} onChange={e=>setQ(e.target.value)} placeholder="Search e.g. welder..." className="flex-1 border p-3 rounded-xl"/><button onClick={doSearch} className="bg-blue-600 text-white px-6 rounded-xl">Search</button></div><div className="grid grid-cols-2 gap-2"><select value={cat} onChange={e=>setCat(e.target.value)} className="border p-3 rounded-xl">{CATS.map(c=><option key={c}>{c}</option>)}</select><select value={loc} onChange={e=>setLoc(e.target.value)} className="border p-3 rounded-xl">{LOCS.map(l=><option key={l}>{l}</option>)}</select></div></div><div className="mt-6"><p className="text-sm text-gray-500">{loading?"Searching...":`${res.length} results`}</p><div className="grid md:grid-cols-3 gap-4 mt-4">{res.map((i:any)=><div key={i.id} className="bg-white p-4 rounded-xl shadow"><span className="text-xs bg-blue-100 text-blue-600 px-2 py-1 rounded-full">{i.category}</span><h3 className="font-bold mt-2">{i.title}</h3><p className="text-sm text-gray-500">{i.name} • {i.location}</p><p className="text-sm mt-2">{i.description?.slice(0,80)}</p><div className="flex gap-2 mt-3"><a href={`tel:+${i.phone}`} className="flex-1 bg-gray-900 text-white text-center py-2 rounded-full text-sm">📞 Call</a><a href={`https://wa.me/${i.whatsapp}`} className="flex-1 bg-green-500 text-white text-center py-2 rounded-full text-sm">WhatsApp</a></div></div>)}</div></div></div>);
}
"use client";
import { useState } from "react";
export default function Admin(){
  const [pw,setPw]=useState(""); const [auth,setAuth]=useState(false); const [skills,setSkills]=useState<any[]>([]); const [jobs,setJobs]=useState<any[]>([]); const [tab,setTab]=useState("skills");
  const ADMIN="efindsgm2026"; async function load(){ const s=await fetch("/api/search?type=skills").then(r=>r.json()); const j=await fetch("/api/search?type=jobs").then(r=>r.json()); setSkills(s); setJobs(j); }
  async function login(){ if(pw===ADMIN){ setAuth(true); load(); } else alert("Wrong"); } async function del(id:string,type:string){ if(!confirm("Delete?")) return; await fetch("/api/admin/delete",{method:"POST",body:JSON.stringify({id,type})}); load(); }
  if(!auth) return (<div className="max-w-md mx-auto bg-white p-6 rounded-2xl shadow mt-10"><h1 className="font-bold">Admin - efindsgm.is-a.dev</h1><input value={pw} onChange={e=>setPw(e.target.value)} type="password" placeholder="Password" className="w-full border p-3 rounded-xl mt-4"/><button onClick={login} className="w-full bg-red-600 text-white py-3 rounded-xl mt-3">Login</button><p className="text-xs mt-2">Default: efindsgm2026 - change in code!</p></div>);
  return (<div><h1 className="text-2xl font-bold">Admin</h1><div className="flex gap-2 mt-4"><button onClick={()=>setTab("skills")} className={`px-4 py-2 rounded-full ${tab==="skills"?"bg-blue-600 text-white":"bg-white"}`}>Skills ({skills.length})</button><button onClick={()=>setTab("jobs")} className={`px-4 py-2 rounded-full ${tab==="jobs"?"bg-gray-900 text-white":"bg-white"}`}>Jobs ({jobs.length})</button></div><div className="mt-6 space-y-2">{(tab==="skills"?skills:jobs).map((i:any)=><div key={i.id} className="bg-white p-4 rounded-xl flex justify-between"><div><p className="font-bold">{i.title} - {i.name}</p><p className="text-sm text-gray-500">{i.category} | {i.phone} | {i.whatsapp}</p></div><button onClick={()=>del(i.id,tab)} className="bg-red-500 text-white px-4 py-2 rounded-full text-sm">Delete</button></div>)}</div></div>);
}
