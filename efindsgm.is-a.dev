  const id=crypto.randomUUID(); await env.DB.prepare("INSERT INTO jobs (id,user_id,title,category,description,budget,location,whatsapp,phone,name,created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?)").bind(id,userId,body.title,body.category,body.description,body.budget,body.location,body.whatsapp,body.phone,user.name,Date.now()).run(); return Response.json({ok:true});
}
import { getRequestContext } from "@cloudflare/next-on-pages";
export async function GET(req: Request){
  const { env } = getRequestContext(); const { searchParams } = new URL(req.url);
  const q=searchParams.get("q")||""; const category=searchParams.get("category")||""; const location=searchParams.get("location")||""; const type=searchParams.get("type")||"skills";
  let cond=[]; let binds:any[]=[]; if(q){cond.push("(title LIKE ? OR description LIKE ?)"); binds.push(`%${q}%`,`%${q}%`);} if(category&&category!="All"){cond.push("category=?"); binds.push(category);} if(location&&location!="All"){cond.push("location LIKE ?"); binds.push(`%${location}%`);}
  let sql=`SELECT * FROM ${type==="jobs"?"jobs":"skills"} ${cond.length?"WHERE "+cond.join(" AND "):""} ORDER BY created_at DESC LIMIT 50`;
  const {results}=await env.DB.prepare(sql).bind(...binds).all(); return Response.json(results);
}
import { getRequestContext } from "@cloudflare/next-on-pages";
export async function POST(req: Request){ const { env }=getRequestContext(); const {id,type}=await req.json(); await env.DB.prepare(`DELETE FROM ${type==="jobs"?"jobs":"skills"} WHERE id=?`).bind(id).run(); return Response.json({ok:true}); }
