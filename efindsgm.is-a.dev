import { getRequestContext } from "@cloudflare/next-on-pages"; import { hashPassword, createToken } from "@/lib/auth";
export async function POST(req: Request){
  const { env } = getRequestContext(); const { name, phone, whatsapp, password, location } = await req.json();
  const existing = await env.DB.prepare("SELECT id FROM users WHERE phone=?").bind(phone).first();
  if(existing) return Response.json({error:"Phone already used"},{status:400});
  const id = crypto.randomUUID(); const password_hash = await hashPassword(password);
  await env.DB.prepare("INSERT INTO users (id,name,phone,whatsapp,password_hash,location,created_at) VALUES (?,?,?,?,?,?,?)").bind(id,name,phone,whatsapp,password_hash,location,Date.now()).run();
  const token = await createToken(id); const res = Response.json({ok:true}); res.headers.set("Set-Cookie",`token=${token}; Path=/; HttpOnly; Max-Age=604800`); return res;
}
import { getRequestContext } from "@cloudflare/next-on-pages"; import { verifyToken } from "@/lib/auth";
export async function GET(req: Request){
  const { env } = getRequestContext(); const cookie = req.headers.get("Cookie")||""; const token = cookie.split("token=")[1]?.split(";")[0];
  if(!token) return Response.json({user:null}); const userId = await verifyToken(token); if(!userId) return Response.json({user:null});
  const user = await env.DB.prepare("SELECT id,name,phone,whatsapp,location FROM users WHERE id=?").bind(userId).first(); return Response.json({user});
}
import { getRequestContext } from "@cloudflare/next-on-pages"; import { verifyToken } from "@/lib/auth";
export async function POST(req: Request){
  const { env } = getRequestContext(); const cookie = req.headers.get("Cookie")||""; const token = cookie.split("token=")[1]?.split(";")[0]; const userId = token?await verifyToken(token):null;
  if(!userId) return Response.json({error:"Login first"},{status:401}); const body:any=await req.json(); const user=await env.DB.prepare("SELECT * FROM users WHERE id=?").bind(userId).first();
  const id=crypto.randomUUID(); await env.DB.prepare("INSERT INTO skills (id,user_id,title,category,description,price,location,whatsapp,phone,name,created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?)").bind(id,userId,body.title,body.category,body.description,body.price,body.location,body.whatsapp,body.phone,user.name,Date.now()).run(); return Response.json({ok:true});
}
import { getRequestContext } from "@cloudflare/next-on-pages"; import { verifyToken } from "@/lib/auth";
export async function POST(req: Request){
  const { env } = getRequestContext(); const cookie = req.headers.get("Cookie")||""; const token = cookie.split("token=")[1]?.split(";")[0]; const userId = token?await verifyToken(token):null;
